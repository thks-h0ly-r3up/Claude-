# ---- Supabase (Project Settings > API) ----
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" secret key. SERVER ONLY. Never put this in the frontend or commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Google Sheets live sync (Apps Script Web app) ----
# Web app URL ending in /exec
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Must equal the WEBHOOK_SECRET script property in Apps Script. Generate with: openssl rand -hex 32
SHEETS_WEBHOOK_SECRET=YOUR_LONG_RANDOM_SECRET

# ---- Premium app payout ----
# Where the "Get the App" button sends people (App Store / Play Store / web-app / Stripe checkout URL)
APP_DOWNLOAD_URL=https://YOUR-DOMAIN.vercel.app/app/

# ---- Paid app: Supabase Auth (public anon key, Project Settings > API "anon public") ----
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# ---- Paid app: Stripe (dashboard.stripe.com > Developers) ----
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
# Signing secret of the webhook endpoint https://YOUR-DOMAIN.vercel.app/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# Recurring monthly Price IDs: Starter $5, Vault $8, Full Access $12
STRIPE_PRICE_STARTER=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_VAULT=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_FULL=price_XXXXXXXXXXXXXXXX
# Your production origin, no trailing slash (used for Stripe redirects)
SITE_URL=https://YOUR-DOMAIN.vercel.app
