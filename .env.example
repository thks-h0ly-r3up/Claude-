# ---- Supabase (Project Settings > API) ----
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" secret key. SERVER ONLY. Never put this in the frontend or commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Google Sheets live sync (Apps Script Web app) ----
# Web app URL ending in /exec
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Must equal the WEBHOOK_SECRET script property in Apps Script. Generate with: openssl rand -hex 32
SHEETS_WEBHOOK_SECRET=YOUR_LONG_RANDOM_SECRET

# ---- Premium app payout ----
# Where the "Get the App" button sends people (App Store / Play Store / web-app / Stripe checkout URL)
APP_DOWNLOAD_URL=https://example.com/app
